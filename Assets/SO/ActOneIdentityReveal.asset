  m_Script: {fileID: 11500000, guid: fa8c24acd717fe843933d0f4fb7b3d77, type: 3}
  m_Name: ActOneIdentityReveal
  m_EditorClassIdentifier: 
  lines:
  - speaker: ???
    text: "\uC7A0\uAE50."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC5B4? \uC7A0\uAE50, \uB204\uAD6C\uC57C?"
  - speaker: ???
    text: "\uADF8 \uC624\uBC31 \uC6D0, \uB0B4\uC9C0 \uB9C8."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uBB50? \uC5B4\uB514\uC11C \uB9D0\uD558\uB294 \uAC70\uC57C?"
  - speaker: ???
    text: "\uB124 \uC804\uB9BD\uC120\uC774\uB2E4."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\u2026\u2026\uBB50?"
  - speaker: ???
    text: "\uC804\uB9BD\uC120."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC544\uB2C8, \uADF8\uAC74 \uC54C\uC544! \uADFC\uB370 \uB124\uAC00 \uC65C
      \uB9D0\uC744 \uD574?!"
  - speaker: "\uC804\uB9BD\uC120"
    text: "\uADF8\uAC74 \uB098\uC911\uC5D0 \uC598\uAE30\uD558\uACE0. \uC9C0\uAE08\uC740
      \uC800 \uC624\uBC31 \uC6D0\uC774 \uBB38\uC81C\uB2E4."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC544\uB2C8, \uADF8\uB0E5 \uB0B4\uBA74 \uB418\uC796\uC544! \uB098 \uC9C0\uAE08
      \uAE09\uD558\uB2E4\uACE0!"
  - speaker: "\uC804\uB9BD\uC120"
    text: "\uC548 \uB41C\uB2E4. \uBB34\uB8CC \uD654\uC7A5\uC2E4\uC744 \uCC3E\uC790."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC544\u2026\u2026 \uC9C4\uC9DC \uBBF8\uCE58\uACA0\uB124."
