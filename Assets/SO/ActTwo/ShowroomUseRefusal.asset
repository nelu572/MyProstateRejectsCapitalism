  lines:
  - speaker: "\uC548\uB0B4"
    text: "\uD574\uB2F9 \uC791\uD488\uC740 \uAD00\uB78C \uC804\uC6A9\uC785\uB2C8\uB2E4.
      \uC774\uC6A9\uD558\uC2E4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC544\uB2C8, \uBCC0\uAE30\uAC00 \uC774\uB807\uAC8C \uB9CE\uC740\uB370
      \uD558\uB098\uB3C4 \uBABB \uC368?"
  - speaker: "\uC804\uB9BD\uC120"
    text: "\uC5EC\uAE34 \uC804\uC2DC\uC7A5\uC774\uB2C8\uAE4C."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uB108\uAE4C\uC9C0 \uC65C \uC774\uB807\uAC8C \uCE68\uCC29\uD55C\uB370?"
