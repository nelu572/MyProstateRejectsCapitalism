  lines:
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uADF8\uB0E5 500\uC6D0 \uB0B4\uBA74 \uC548 \uB3FC?"
  - speaker: "\uC804\uB9BD\uC120"
    text: "500\uC6D0\uC774 \uBB38\uC81C\uAC00 \uC544\uB2C8\uB2E4. \uC6D0\uCE59\uC758
      \uBB38\uC81C\uB2E4."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uADFC\uB370 \uC65C \uB124\uAC00 \uACB0\uC815\uD558\uB294\uB370?"
  - speaker: "\uC804\uB9BD\uC120"
    text: "\uB098\uB294 \uB124 \uC804\uB9BD\uC120\uC774\uB2E4. \uD558\uC9C0\uB9CC
      \uB124 \uC18C\uC720\uBB3C\uC740 \uC544\uB2C8\uB2E4."
