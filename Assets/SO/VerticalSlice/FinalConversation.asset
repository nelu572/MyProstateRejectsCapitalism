  lines:
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\u2026\u2026\uB4DC\uB514\uC5B4. \uC5EC\uAE34 \uC9C4\uC9DC \uBB34\uB8CC\uC9C0?"
  - speaker: "\uC804\uB9BD\uC120"
    text: "\uB300\uAC00\uB97C \uC694\uAD6C\uD558\uC9C0 \uC54A\uB294\uAD70."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC774 \uB2F9\uC5F0\uD55C \uAC78 \uCC3E\uC73C\uB824\uACE0 \uADF8\uB807\uAC8C
      \uB3CC\uC544\uC654\uB124."
  - speaker: "\uC804\uB9BD\uC120"
    text: "\uB3CC\uC544\uC628 \uBCF4\uB78C\uC774 \uC788\uAD70. \uBB38\uBD80\uD130
      \uB2EB\uC544\uB77C."
