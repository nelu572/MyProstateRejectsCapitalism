  lines:
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uBB34\uB8CC\uB77C\uBA70. \uC9C0\uAE08 \uAD11\uACE0 \uBCFC \uD2C8\uC774
      \uC5B4\uB514 \uC788\uC5B4?"
  - speaker: "\uC804\uB9BD\uC120"
    text: "\uAD11\uACE0\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uB124 \uC2DC\uAC04\uC744
      \uAC00\uC838\uAC00\uACA0\uB2E4\uB294 \uAC70\uB2E4."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uADF8\uB7FC \uC5EC\uAE30\uB3C4 \uBABB \uC4F0\uB294 \uAC70\uC57C?"
  - speaker: "\uC804\uB9BD\uC120"
    text: "\uC5EC\uAE34 \uC9C0\uB098\uCE58\uC790. \uC606 \uD1B5\uB85C\uB85C \uAC00\uC790."
