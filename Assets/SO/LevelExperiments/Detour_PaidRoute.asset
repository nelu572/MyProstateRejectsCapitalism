  lines:
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uD654\uC7A5\uC2E4\uC774 \uBC14\uB85C \uC800\uAE30\uC796\uC544. \uB2E4\uB9AC
      \uD558\uB098 \uAC74\uB108\uB294 \uB370 500\uC6D0?"
  - speaker: "\uC804\uB9BD\uC120"
    text: "\uBCC0\uAE30\uB294 \uBB34\uB8CC\uB77C\uB354\uB2C8, \uAC00\uB294 \uAE38\uC744
      \uD314\uACE0 \uC788\uAD70. \uC67C\uCABD\uC73C\uB85C \uB3CC\uC544\uAC00\uC790."
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC800\uAE30 \uC788\uB294 \uAC74 \uBCF4\uC774\uB294\uB370\u2026\u2026."
